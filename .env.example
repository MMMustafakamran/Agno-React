# Copy to backend/.env (or a repo-root .env) and fill in.
# Never commit the filled-in file.

# ── Required ────────────────────────────────────────────────────────────────

# Model provider key. Read by the Agno process only — it is never sent to the
# browser, because the browser never talks to the agent directly.
OPENAI_API_KEY=sk-...


# ── Backend, optional ───────────────────────────────────────────────────────

# Model the agent runs. The Agno quickstart prints `gpt-5.4`, which is not
# available on every account, so the default here is `gpt-4o`.
# OPENAI_MODEL=gpt-4o

# Port for the Agno AgentOS server. Change this and AGNO_AGENT_URL together.
# AGENT_PORT=8000

# Origins allowed to call the agent directly. Only matters if you bypass the
# runtime; the normal path is server-to-server and needs no CORS.
# AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ── Frontend, optional ──────────────────────────────────────────────────────
# These belong in frontend/.env.local (Next.js does not read this file).

# Where the runtime reaches the Agno AG-UI endpoint. Use 127.0.0.1 if localhost
# resolves to IPv6 while the agent binds IPv4.
# AGNO_AGENT_URL=http://localhost:8000/agui

# CopilotKit Intelligence public license key (browser-safe, `ck_pub_...`).
# Without it the app runs fine but every Rich Threads route shows its locked
# state. This is NOT the same as INTELLIGENCE_API_KEY, which is a server-side
# project secret written by the CopilotKit CLI.
# NEXT_PUBLIC_COPILOTKIT_LICENSE_KEY=ck_pub_...

# CopilotKit Intelligence project key (server-side, from the free account in
# quickstart step 1). Set it and the runtime routes wire `CopilotKitIntelligence`
# plus `identifyUser`; leave it unset and they fall back to SSE with an
# in-memory runner — chat works, Threads and the Inspector stay locked.
# INTELLIGENCE_API_KEY=your_license_key

# Opt out of CopilotKit's anonymous runtime telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
